# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local API captures (contain live session cookies)
apipass*.md
aipass*.md
*.har

# staged into the VS Code extension by vscode/build.mjs; source of truth is
# aipass-bridge/agent/core.mjs
/aipass-bridge/vscode/agent/
/aipass-bridge/vscode/LICENSE
/aipass-bridge/vscode/*.vsix

# local working plan — deliberately not shared
/PLAN.md
